---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';
import matter from 'gray-matter';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const root = process.cwd();

  return blogEntries.map(entry => {
    const slug = entry.id;
    const raw = readFileSync(resolve(root, 'src/content/blog', `${slug}.md`), 'utf-8');
    const fm = matter(raw).data;

    return {
      params: { slug },
      props: {
        entry,
		frontmatter: {
		  title: String(fm.title ?? entry.data.title ?? ''),
		  description: String(fm.description ?? entry.data.description ?? ''),
		  pubDate: fm.pubDate ? new Date(fm.pubDate) : entry.data.pubDate,
		  updatedDate: fm.updatedDate ? new Date(fm.updatedDate) : undefined,
		  tags: Array.isArray(fm.tags) ? fm.tags : undefined,
		  image: fm.image ?? undefined,
		  shareX: fm.shareX ?? undefined,
		  shareWhatsApp: fm.shareWhatsApp ?? undefined,
		  shareReddit: fm.shareReddit ?? undefined,
		  shareInstagram: fm.shareInstagram ?? undefined,
		},
      },
    };
  });
}

const { entry, frontmatter } = Astro.props;
const { Content } = await render(entry);

const allEntries = await getCollection('blog');
const related = allEntries
  .filter(e => e.id !== entry.id)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3)
  .map(e => ({ slug: e.id, title: e.data.title, pubDate: e.data.pubDate }));
const allPosts = allEntries
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .map(e => ({ slug: e.id, title: e.data.title, pubDate: e.data.pubDate }));
---

<BlogLayout title={frontmatter.title} description={frontmatter.description} pubDate={frontmatter.pubDate}
  updatedDate={frontmatter.updatedDate}
  tags={frontmatter.tags}
  shareX={frontmatter.shareX}
  shareWhatsApp={frontmatter.shareWhatsApp}
  shareReddit={frontmatter.shareReddit}
  shareInstagram={frontmatter.shareInstagram}
  image={frontmatter.image}
  relatedPosts={related}
  allPosts={allPosts}
>
  <Content />
</BlogLayout>
