---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const blogEntries = await getCollection('blog');
blogEntries.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Blog — Edgardo Vásquez" description="Artículos sobre tecnología, liderazgo y arquitectura de software.">
	<button id="blog-listing-theme-toggle" class="blog-listing-theme-btn" aria-label="Cambiar tema">
		<svg class="sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
		<svg class="moon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
	</button>
	<main class="blog-listing">
		<section class="container">
			<header class="blog-listing-header">
				<a href="/" class="blog-back-home">&larr; Inicio</a>
				<h1 class="blog-listing-title">Blog</h1>
				<p class="blog-listing-desc">Artículos sobre tecnología, liderazgo, arquitectura cloud y más.</p>
			</header>

			{
				blogEntries.length > 0 ? (
					<div class="blog-grid">
						{blogEntries.map(entry => <BlogCard entry={entry} />)}
					</div>
				) : (
					<div class="blog-empty">
						<p>Aún no hay artículos publicados. ¡Vuelve pronto!</p>
					</div>
				)
			}
		</section>
	</main>
</Layout>

<style>
	.blog-listing {
		padding: 110px 0 80px;
		min-height: 60vh;
	}

	.blog-listing-header {
		margin-bottom: 48px;
	}

	.blog-back-home {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--accent-emerald);
		margin-bottom: 16px;
		transition: var(--transition);
	}
	.blog-back-home:hover {
		color: var(--accent-indigo);
	}

	.blog-listing-title {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		font-weight: 900;
		letter-spacing: -0.03em;
		line-height: 1.05;
		margin-bottom: 16px;
	}

	.blog-listing-desc {
		font-size: 1.15rem;
		color: var(--text-secondary);
		max-width: 640px;
	}

	.blog-grid {
		display: grid;
		gap: 24px;
	}

	.blog-empty {
		text-align: center;
		padding: 80px 0;
		color: var(--text-muted);
		font-size: 1.1rem;
	}

	.blog-listing-theme-btn {
		position: fixed;
		top: 16px;
		right: 16px;
		z-index: 1001;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 50%;
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: var(--transition);
		color: var(--text-primary);
	}
	.blog-listing-theme-btn:hover {
		background: var(--surface-card);
		transform: scale(1.05);
	}
	.blog-listing-theme-btn svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.blog-listing-theme-btn .sun { display: block; }
	.blog-listing-theme-btn .moon { display: none; }
	[data-theme="light"] .blog-listing-theme-btn .sun { display: none; }
	[data-theme="light"] .blog-listing-theme-btn .moon { display: block; }

	@media (width <= 600px) {
		.blog-listing {
			padding: 40px 0 60px;
		}
	}
</style>

<script>
	const listingBtn = document.getElementById('blog-listing-theme-toggle');
	if (listingBtn) {
		listingBtn.addEventListener('click', () => {
			const html = document.documentElement;
			const isLight = html.getAttribute('data-theme') === 'light';
			const newTheme = isLight ? 'dark' : 'light';
			html.setAttribute('data-theme', newTheme);
			localStorage.setItem('theme', newTheme);
		});
	}
</script>
