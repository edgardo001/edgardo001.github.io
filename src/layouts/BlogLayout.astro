---
import ShareButtons from '../components/ShareButtons.astro';
import rawCritical from '../styles/critical.css?raw';
import globalCSS from '../styles/global.css?url';

export interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	shareX?: string;
	shareWhatsApp?: string;
	shareReddit?: string;
	shareInstagram?: string;
	image?: string;
	relatedPosts?: { slug: string; title: string; pubDate: Date }[];
	allPosts?: { slug: string; title: string; pubDate: Date }[];
}

const { title, description, pubDate, updatedDate, tags, shareX, shareWhatsApp, shareReddit, shareInstagram, image, relatedPosts, allPosts } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = String(Astro.site).replace(/\/$/, '');
const imageURL = image ? `${siteURL}${image}` : null;
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="description" content={description} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:type" content="article" />
	<meta property="og:url" content={canonicalURL} />
	<meta property="og:site_name" content="Edgardo Vásquez" />
	{imageURL ? <meta property="og:image" content={imageURL} /> : null}
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	{imageURL ? <meta name="twitter:image" content={imageURL} /> : null}
	<title>{title} — Edgardo Vásquez</title>
	<link rel="canonical" href={canonicalURL} />
	<link rel="alternate" type="application/rss+xml" title="Edgardo Vásquez — Blog" href="/rss.xml" />
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Article",
		"headline": title,
		"description": description,
		"datePublished": pubDate.toISOString(),
		"author": {
			"@type": "Person",
			"name": "Edgardo Vásquez Valenzuela",
			"url": "https://edgardovasquez.cl"
		},
		"publisher": {
			"@type": "Person",
			"name": "Edgardo Vásquez Valenzuela",
			"url": "https://edgardovasquez.cl"
		},
		"url": canonicalURL.toString(),
		"mainEntityOfPage": canonicalURL.toString()
	})} is:inline></script>
	<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧑‍💻</text></svg>">

	<style is:inline set:html={rawCritical}></style>
	<link rel="stylesheet" href={globalCSS} media="print" onload="this.media='all';this.onload=null" />
	<noscript><link rel="stylesheet" href={globalCSS} /></noscript>

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link rel="preconnect" href="https://www.googletagmanager.com" />
	<link rel="preload" as="font" href="https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2" type="font/woff2" crossorigin>
	<link rel="preload" as="font" href="https://fonts.gstatic.com/s/outfit/v15/QGYvz_MVcBeNP4NJtEtqUYLknw.woff2" type="font/woff2" crossorigin>
	<link rel="preload" as="font" href="https://fonts.gstatic.com/s/firacode/v27/uU9NCBsR6Z2vfE9aq3bh3dSDqFGedA.woff2" type="font/woff2" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800;900&display=swap" media="print" onload="this.media='all'; this.onload=null;" />
	<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800;900&display=swap" /></noscript>

	<script async src="https://www.googletagmanager.com/gtag/js?id=G-HQ7V2L86TR" is:inline></script>
	<script is:inline>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', 'G-HQ7V2L86TR');
	</script>

	<script is:inline>
		const initialTheme = localStorage.getItem('theme') ||
			(window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
		document.documentElement.setAttribute('data-theme', initialTheme);
		requestAnimationFrame(() => document.documentElement.classList.add('ready'));
	</script>
</head>
<body>
	<div id="progress-bar" class="progress-bar"></div>
	<div id="font-controls" class="font-controls">
		<button id="font-decrease" class="font-btn" aria-label="Reducir tamaño de letra">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20 9 4h2l6 16"/><path d="M5 15h8"/><path d="M15 14h8"/></svg>
		</button>
		<button id="font-increase" class="font-btn" aria-label="Aumentar tamaño de letra">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20 9 4h2l6 16"/><path d="M5 15h8"/><path d="M19 10v8"/><path d="M15 14h8"/></svg>
		</button>
	</div>
	<button id="back-to-top" class="back-to-top" aria-label="Ir abajo">
		<svg class="arrow-up" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
		<svg class="arrow-down" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
	</button>
	<button id="blog-posts-toggle" class="blog-posts-toggle" aria-label="Abrir lista de artículos">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
	</button>
	<button id="blog-theme-toggle" class="blog-theme-btn" aria-label="Cambiar tema">
		<svg class="sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
		<svg class="moon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
	</button>
	<nav class="blog-breadcrumbs" aria-label="Breadcrumb">
		<ol>
			<li><a href="/">Inicio</a></li>
			<li><a href="/blog/">Blog</a></li>
			<li aria-current="page">{title}</li>
		</ol>
	</nav>
	<article class="blog-article">
		<header class="blog-header">
			<a href="/blog/" class="blog-back">&larr; Volver al blog</a>
			<h1 class="blog-title">{title}</h1>
			<p class="blog-description">{description}</p>
			<div class="blog-meta">
				<time class="blog-date" datetime={pubDate.toISOString()}>
					{new Intl.DateTimeFormat('es-CL', { dateStyle: 'long' }).format(pubDate)}
				</time>
				<span class="blog-reading-time" id="reading-time"></span>
				{updatedDate && (
					<time class="blog-updated" datetime={updatedDate.toISOString()}>
						· Actualizado {new Intl.DateTimeFormat('es-CL', { dateStyle: 'long' }).format(updatedDate)}
					</time>
				)}
			</div>
			{tags && tags.length > 0 && (
				<div class="blog-tags">
					{tags.map(tag => <span class="blog-tag">{tag}</span>)}
				</div>
			)}
		</header>
		<div class="blog-content">
			<slot />
		</div>
		<ShareButtons url={canonicalURL.toString()} title={title} description={description}
			shareX={shareX}
			shareWhatsApp={shareWhatsApp}
			shareReddit={shareReddit}
			shareInstagram={shareInstagram}
		/>
		{relatedPosts && relatedPosts.length > 0 && (
			<aside class="related-posts">
				<h2 class="related-posts-title">Artículos relacionados</h2>
				<div class="related-posts-grid">
					{relatedPosts.map(post => (
						<a href={`/blog/${post.slug}/`} class="related-post-card">
							<time datetime={post.pubDate.toISOString()}>
								{new Intl.DateTimeFormat('es-CL', { dateStyle: 'long' }).format(post.pubDate)}
							</time>
							<span>{post.title}</span>
						</a>
					))}
				</div>
			</aside>
		)}
	</article>

	<aside class="author-box" aria-label="Sobre el autor">
		<div class="author-box-avatar">
			<img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%2300875a' rx='50'/%3E%3Ctext x='50' y='66' font-size='48' text-anchor='middle' fill='white'%3EEV%3C/text%3E%3C/svg%3E" alt="Edgardo Vásquez" width="64" height="64" loading="lazy" />
		</div>
		<div class="author-box-info">
			<strong class="author-box-name">Edgardo Vásquez Valenzuela</strong>
			<span class="author-box-role">Solutions Architect · Tech Lead · Senior Software Engineer</span>
			<p class="author-box-bio">12+ años construyendo plataformas críticas, liderando equipos y orquestando agentes de IA. Apasionado por la gestión del cambio, la inclusión organizacional y la arquitectura de software.</p>
			<a href="/" class="author-box-link">Conocer más &rarr;</a>
		</div>
	</aside>

	<button id="toc-toggle" class="toc-toggle" aria-label="Abrir tabla de contenidos">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
	</button>
	<aside id="toc-panel" class="toc-panel" aria-label="Tabla de contenidos">
		<div class="toc-panel-header">
			<span class="toc-panel-title">Contenido</span>
		</div>
		<nav class="toc-panel-body"></nav>
	</aside>
	<button id="toc-close" class="toc-close sidebar-close" aria-label="Cerrar">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
	</button>
	<div id="toc-overlay" class="panel-overlay"></div>

	<aside id="posts-panel" class="posts-panel" aria-label="Todos los artículos">
		<div class="posts-panel-header">
			<span class="posts-panel-title">Artículos</span>
		</div>
		<nav class="posts-panel-body">
			{allPosts && allPosts.length > 0 && (
				<ul class="posts-list">
					{allPosts.map(post => (
						<li>
							<a href={`/blog/${post.slug}/`} class="posts-list-link">
								<time datetime={post.pubDate.toISOString()}>{new Intl.DateTimeFormat('es-CL', { dateStyle: 'long' }).format(post.pubDate)}</time>
								<span>{post.title}</span>
							</a>
						</li>
					))}
				</ul>
			)}
		</nav>
	</aside>
	<button id="posts-close" class="posts-close sidebar-close" aria-label="Cerrar">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
	</button>
	<div id="posts-overlay" class="panel-overlay"></div>

	<div id="img-modal" class="img-modal" role="dialog" aria-modal="true" aria-label="Vista ampliada de imagen">
		<button class="img-modal-close" aria-label="Cerrar">&times;</button>
		<img class="img-modal-content" alt="" />
		<div class="img-modal-zoom-bar">
			<button class="img-modal-zoom-btn" data-zoom="out" aria-label="Reducir zoom">−</button>
			<button class="img-modal-zoom-btn" data-zoom="reset" aria-label="Restablecer zoom">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
			</button>
			<button class="img-modal-zoom-btn" data-zoom="in" aria-label="Aumentar zoom">+</button>
		</div>
	</div>

	<script>
		const themeBtn = document.getElementById('blog-theme-toggle');
		if (themeBtn) {
			themeBtn.addEventListener('click', () => {
				const html = document.documentElement;
				const isLight = html.getAttribute('data-theme') === 'light';
				const newTheme = isLight ? 'dark' : 'light';
				html.setAttribute('data-theme', newTheme);
				localStorage.setItem('theme', newTheme);
			});
		}

		const modal = document.getElementById('img-modal');
		const modalImg = modal.querySelector('.img-modal-content');
		const modalClose = modal.querySelector('.img-modal-close');
		const zoomBtns = modal.querySelectorAll('.img-modal-zoom-btn');
		let zoomLevel = 1;

		function setZoom(level) {
			zoomLevel = Math.max(0.25, Math.min(5, level));
			modalImg.style.transform = `scale(${zoomLevel})`;
		}

		function openModal(src, alt) {
			modalImg.src = src;
			modalImg.alt = alt || '';
			zoomLevel = 1;
			modalImg.style.transform = '';
			modal.classList.add('open');
			document.body.style.overflow = 'hidden';
		}

		function closeModal() {
			modal.classList.remove('open');
			document.body.style.overflow = '';
		}

		document.querySelector('.blog-content')?.addEventListener('click', (e) => {
			const img = e.target.closest('img');
			if (img) openModal(img.src, img.alt);
		});

		modalClose.addEventListener('click', closeModal);
		modal.addEventListener('click', (e) => {
			if (e.target === modal) closeModal();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
		});

		zoomBtns.forEach((btn) => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const action = btn.dataset.zoom;
				if (action === 'in') setZoom(zoomLevel * 1.4);
				else if (action === 'out') setZoom(zoomLevel / 1.4);
				else if (action === 'reset') setZoom(1);
			});
		});

		// Reading time
		const content = document.querySelector('.blog-content');
		if (content) {
			const text = content.innerText || '';
			const words = text.split(/\s+/).filter(Boolean).length;
			const min = Math.max(1, Math.round(words / 200));
			const rt = document.getElementById('reading-time');
			if (rt) rt.textContent = `· ${min} min de lectura`;
		}

		// Progress bar
		const bar = document.getElementById('progress-bar');
		if (bar) {
			window.addEventListener('scroll', () => {
				const scrollTop = window.scrollY;
				const docHeight = document.documentElement.scrollHeight - window.innerHeight;
				const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
				bar.style.width = progress + '%';
			});
		}

		// Back to top / bottom
		const backBtn = document.getElementById('back-to-top');
		if (backBtn) {
			window.addEventListener('scroll', () => {
				const atTop = window.scrollY < 200;
				const show = !atTop || window.innerHeight < document.documentElement.scrollHeight;
				backBtn.classList.toggle('visible', show);
				backBtn.classList.toggle('back-to-top--at-top', atTop);
				backBtn.setAttribute('aria-label', atTop ? 'Ir abajo' : 'Volver arriba');
			});
			backBtn.addEventListener('click', () => {
				if (backBtn.classList.contains('back-to-top--at-top')) {
					window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
				} else {
					window.scrollTo({ top: 0, behavior: 'smooth' });
				}
			});
		}

		// Font size controls
		const fontInc = document.getElementById('font-increase');
		const fontDec = document.getElementById('font-decrease');
		const FONT_KEY = 'blog-font-size';
		const MIN = 0.8;
		const MAX = 1.5;
		const STEP = 0.1;
		let fontSize = parseFloat(localStorage.getItem(FONT_KEY)) || 1.125;
		function applyFontSize() {
			fontSize = Math.min(MAX, Math.max(MIN, fontSize));
			localStorage.setItem(FONT_KEY, String(fontSize));
			document.documentElement.style.setProperty('--blog-font-size', fontSize + 'rem');
		}
		applyFontSize();
		document.getElementById('font-controls')?.classList.add('font-controls--visible');
		fontInc?.addEventListener('click', () => { fontSize += STEP; applyFontSize(); flash(fontInc); });
		fontDec?.addEventListener('click', () => { fontSize -= STEP; applyFontSize(); flash(fontDec); });
		function flash(el) {
			el.style.transform = 'scale(0.85)';
			el.style.transition = 'transform 0.1s';
			setTimeout(() => el.style.transform = 'scale(1)', 100);
		}

		const isMobile = () => window.innerWidth <= 768;
		let scrollPos = 0;

		function slugify(text) {
			return text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
		}

		function lockScroll() {
			scrollPos = window.scrollY;
			document.body.style.overflow = 'hidden';
			document.body.style.position = 'fixed';
			document.body.style.top = `-${scrollPos}px`;
			document.body.style.width = '100%';
		}

		function unlockScroll() {
			document.body.style.overflow = '';
			document.body.style.position = '';
			document.body.style.top = '';
			document.body.style.width = '';
			window.scrollTo(0, scrollPos);
		}

		function closeAllPanels() {
			['toc-panel', 'posts-panel'].forEach(id => {
				const p = document.getElementById(id);
				if (p?.classList.contains(id + '--open')) {
					const overlayId = id === 'toc-panel' ? 'toc-overlay' : 'posts-overlay';
					const closeId = id === 'toc-panel' ? 'toc-close' : 'posts-close';
					p.classList.remove(id + '--open');
					document.getElementById(overlayId)?.classList.remove('panel-overlay--open');
					document.getElementById(closeId)?.classList.remove('sidebar-close--visible');
				}
			});
			if (isMobile()) unlockScroll();
		}

		// TOC — sidebar derecho
		if (content) {
			const headings = content.querySelectorAll('h2, h3');
			if (headings.length > 0) {
				const panel = document.getElementById('toc-panel');
				const overlay = document.getElementById('toc-overlay');
				const body = panel.querySelector('.toc-panel-body');
				const toggle = document.getElementById('toc-toggle');
				const close = document.getElementById('toc-close');
				const list = document.createElement('ul');
				list.className = 'toc-list';
				const tocLinks = [];
				headings.forEach((h) => {
					const id = slugify(h.textContent);
					h.id = id;
					// Link button para copiar enlace directo a la sección
					const linkBtn = document.createElement('a');
					linkBtn.className = 'heading-link';
					linkBtn.setAttribute('aria-label', 'Copiar enlace a esta sección');
					linkBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
					linkBtn.href = '#' + id;
					linkBtn.addEventListener('click', (e) => {
						e.preventDefault();
						const url = window.location.origin + window.location.pathname + '#' + id;
						navigator.clipboard.writeText(url).then(() => {
							linkBtn.classList.add('heading-link--copied');
							setTimeout(() => linkBtn.classList.remove('heading-link--copied'), 2000);
						});
						history.replaceState(null, '', '#' + id);
					});
					h.appendChild(linkBtn);
					// TOC item
					const li = document.createElement('li');
					li.className = h.tagName === 'H3' ? 'toc-h3' : 'toc-h2';
					const a = document.createElement('a');
					a.href = '#' + id;
					a.textContent = h.textContent;
					li.appendChild(a);
					list.appendChild(li);
					tocLinks.push({ el: a, heading: h });
				});
				body.appendChild(list);

				function openToc() {
					panel.classList.add('toc-panel--open');
					overlay.classList.add('panel-overlay--open');
					close.classList.add('sidebar-close--visible');
					if (isMobile()) lockScroll();
					close.focus();
				}
				function closeToc() {
					panel.classList.remove('toc-panel--open');
					overlay.classList.remove('panel-overlay--open');
					close.classList.remove('sidebar-close--visible');
					if (isMobile()) unlockScroll();
					toggle.focus();
				}

				toggle.addEventListener('click', (e) => { e.stopPropagation(); openToc(); });
				close.addEventListener('click', closeToc);
				overlay.addEventListener('click', closeToc);

				// Smooth scroll en anclas TOC + cerrar panel
				body.addEventListener('click', (e) => {
					const link = e.target.closest('a');
					if (!link) return;
					e.preventDefault();
					const id = link.getAttribute('href').slice(1);
					const target = document.getElementById(id);
					if (target) {
						target.scrollIntoView({ behavior: 'smooth' });
						history.replaceState(null, '', '#' + id);
					}
					closeToc();
				});

				toggle.classList.add('toc-toggle--visible');

				// IntersectionObserver para resaltar enlace activo
				const observer = new IntersectionObserver((entries) => {
					let active = '';
					entries.forEach(entry => {
						if (entry.isIntersecting) active = entry.target.id;
					});
					tocLinks.forEach(({ el }) => {
						const isActive = el.getAttribute('href').slice(1) === active;
						el.classList.toggle('toc-active', isActive);
					});
				}, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });

				headings.forEach(h => observer.observe(h));
			}
		}

		// Scroll inicial a hash en la URL (deep linking)
		if (window.location.hash) {
			const id = window.location.hash.slice(1);
			const attempt = () => {
				const target = document.getElementById(id);
				if (target) {
					target.scrollIntoView({ behavior: 'smooth' });
					return true;
				}
				return false;
			};
			if (!attempt()) {
				// Si las cabeceras aún no tienen ID (ej: sin TOC), reintentar después
				let tries = 0;
				const interval = setInterval(() => {
					tries++;
					if (attempt() || tries > 20) clearInterval(interval);
				}, 100);
			}
		}

		// Posts panel — sidebar izquierdo
		const postsToggle = document.getElementById('blog-posts-toggle');
		const postsPanel = document.getElementById('posts-panel');
		const postsOverlay = document.getElementById('posts-overlay');
		const postsClose = document.getElementById('posts-close');
		if (postsToggle && postsPanel) {
			function openPosts() {
				postsPanel.classList.add('posts-panel--open');
				postsOverlay.classList.add('panel-overlay--open');
				postsClose.classList.add('sidebar-close--visible');
				if (isMobile()) lockScroll();
				postsClose.focus();
			}
			function closePosts() {
				postsPanel.classList.remove('posts-panel--open');
				postsOverlay.classList.remove('panel-overlay--open');
				postsClose.classList.remove('sidebar-close--visible');
				if (isMobile()) unlockScroll();
				postsToggle.focus();
			}

			postsToggle.addEventListener('click', (e) => { e.stopPropagation(); openPosts(); });
			postsClose.addEventListener('click', closePosts);
			postsOverlay.addEventListener('click', closePosts);
			postsPanel.querySelector('.posts-panel-body')?.addEventListener('click', closePosts);

			postsToggle.classList.add('blog-posts-toggle--visible');
		}

		// Resaltar artículo actual en posts panel
		const currentSlug = window.location.pathname.replace(/\/blog\//, '').replace(/\/$/, '') || '';
		if (currentSlug) {
			document.querySelectorAll('.posts-list-link').forEach(link => {
				const href = link.getAttribute('href');
				if (href && href.includes(currentSlug)) {
					link.classList.add('posts-list-link--active');
				}
			});
		}

		// Cerrar cualquier panel con Escape
		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape') return;
			closeAllPanels();
		});

		// Keyboard shortcuts
		const allLinks = Array.from(document.querySelectorAll('.posts-list a'));
		const currentIdx = allLinks.findIndex(a => {
			const href = a.getAttribute('href').replace(/\/$/, '');
			return href === currentPath;
		});
		document.addEventListener('keydown', (e) => {
			if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;
			if (e.key === 't' || e.key === 'T') {
				e.preventDefault();
				const panel = document.getElementById('toc-panel');
				if (panel?.classList.contains('toc-panel--open')) {
					document.getElementById('toc-close')?.click();
				} else {
					document.getElementById('toc-toggle')?.click();
				}
			}
			if (e.key === '?' && e.shiftKey) {
				e.preventDefault();
				showShortcutsHelp();
			}
			if (e.key === 'j' && currentIdx >= 0 && currentIdx < allLinks.length - 1) {
				e.preventDefault();
				window.location.href = allLinks[currentIdx + 1].getAttribute('href');
			}
			if (e.key === 'k' && currentIdx > 0) {
				e.preventDefault();
				window.location.href = allLinks[currentIdx - 1].getAttribute('href');
			}
		});
		function showShortcutsHelp() {
			const existing = document.getElementById('shortcuts-help');
			if (existing) { existing.remove(); return; }
			const div = document.createElement('div');
			div.id = 'shortcuts-help';
			div.className = 'shortcuts-help';
			div.setAttribute('role', 'dialog');
			div.setAttribute('aria-label', 'Atajos de teclado');
			div.innerHTML = `<div class="shortcuts-help-content"><h3>Atajos de teclado</h3><table><tr><td><kbd>j</kbd></td><td>Artículo siguiente</td></tr><tr><td><kbd>k</kbd></td><td>Artículo anterior</td></tr><tr><td><kbd>t</kbd></td><td>Abrir/cerrar tabla de contenidos</td></tr><tr><td><kbd>?</kbd></td><td>Mostrar esta ayuda</td></tr><tr><td><kbd>Esc</kbd></td><td>Cerrar paneles</td></tr></table><button class="shortcuts-help-close" aria-label="Cerrar">Cerrar</button></div>`;
			document.body.appendChild(div);
			div.querySelector('.shortcuts-help-close')?.addEventListener('click', () => div.remove());
			div.addEventListener('click', (e) => { if (e.target === div) div.remove(); });
		}

		// Copy code button
		const currentPath = window.location.pathname.replace(/\/$/, '');
		content.querySelectorAll('pre').forEach((pre) => {
			const btn = document.createElement('button');
			btn.className = 'copy-btn';
			btn.textContent = 'Copiar';
			btn.addEventListener('click', async () => {
				try {
					const code = pre.querySelector('code');
					await navigator.clipboard.writeText(code ? code.innerText : pre.innerText);
					btn.textContent = 'Copiado!';
					btn.classList.add('copy-btn--done');
					setTimeout(() => {
						btn.textContent = 'Copiar';
						btn.classList.remove('copy-btn--done');
					}, 2000);
				} catch {
					btn.textContent = 'Error';
					setTimeout(() => btn.textContent = 'Copiar', 2000);
				}
			});
			pre.classList.add('pre--has-copy');
			pre.appendChild(btn);
		});

		// Reading position — save & restore scroll
		const POS_KEY = 'blog-scroll-' + currentPath;
		const savedPos = localStorage.getItem(POS_KEY);
		if (savedPos) {
			const pos = parseFloat(savedPos);
			if (pos > 0) {
				requestAnimationFrame(() => window.scrollTo(0, pos));
			}
		}
		let scrollTimer;
		window.addEventListener('scroll', () => {
			clearTimeout(scrollTimer);
			scrollTimer = setTimeout(() => {
				localStorage.setItem(POS_KEY, String(window.scrollY));
			}, 1000);
		});
	</script>
</body>
