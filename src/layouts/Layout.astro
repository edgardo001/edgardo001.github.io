---
import rawCritical from '../styles/critical.css?raw';
import globalCSS from '../styles/global.css?url';
import i18nUrl from '../i18n/init.js?url';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Edgardo Vásquez Valenzuela | Solutions Architect · Tech Lead",
	description = "Portafolio Profesional de Edgardo Vásquez Valenzuela - Solutions Architect, Tech Lead y Senior Software Engineer. 12 años de experiencia construyendo plataformas críticas."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" data-i18n-attr="lang">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧑‍💻</text></svg>">
    <title>{title}</title>

    <!-- Preload hero LCP image -->
    <link rel="preload" as="image" href="/mpedf3pv-img.avif" type="image/avif" fetchpriority="high">

    <!-- Preconnect hints for critical third-party origins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://cdn.simpleicons.org" />

    <!-- Critical CSS inline -->
    <style is:inline set:html={rawCritical}></style>

    <!-- Global CSS (async: print media swaps to all on load) -->
    <link rel="stylesheet" href={globalCSS} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={globalCSS} /></noscript>

    <!-- Google Fonts: preload + async CSS with display=optional (no swap CLS) -->
    <link rel="preload" as="font" href="https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="https://fonts.gstatic.com/s/outfit/v15/QGYvz_MVcBeNP4NJtEtqUYLknw.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="https://fonts.gstatic.com/s/firacode/v27/uU9NCBsR6Z2vfE9aq3bh3dSDqFGedA.woff2" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800;900&display=optional" media="print" onload="this.media='all';this.onload=null" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800;900&display=optional" /></noscript>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HQ7V2L86TR" is:inline></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.addEventListener('load', () => {
            gtag('js', new Date());
            gtag('config', 'G-HQ7V2L86TR');
        });
    </script>

    <!-- Script síncrono para evitar el parpadeo del tema claro/oscuro -->
    <script is:inline>
        const initialTheme = localStorage.getItem('theme') ||
            (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', initialTheme);
        requestAnimationFrame(() => document.documentElement.classList.add('ready'));
    </script>
</head>
<body>
    <slot />
    <script is:inline>
        const SUPPORTED_LANGS = ['es', 'en'];
        function i18nLang() {
            const s = localStorage.getItem('lang');
            if (s && SUPPORTED_LANGS.includes(s)) return s;
            const b = navigator.language?.split('-')[0];
            return b && SUPPORTED_LANGS.includes(b) ? b : 'es';
        }
        window.__i18n = {
            currentLang: i18nLang,
            changeLanguage(lng) {
                localStorage.setItem('lang', lng);
                document.dispatchEvent(new CustomEvent('languageChanged', { detail: lng }));
            },
            _ready: false
        };
    </script>
    <!-- i18next loaded after page load to reduce main thread work -->
    <script is:inline set:html={`window.addEventListener('load', () => { import('${i18nUrl}'); });`} />
</body>
</html>
